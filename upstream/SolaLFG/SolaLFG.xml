	<!-- Frame Template (BackdropTemplate) -->
	<Frame name="FP_FrameTemplate" inherits="BackdropTemplate" frameStrata="HIGH" virtual="true">
		<KeyValues>
			<KeyValue key="backdropInfo" value="FP_Backdrop_Info" type="global"/>
		</KeyValues>
		<Scripts>
			<OnLoad>
				if BackdropTemplateMixin and BackdropTemplateMixin.OnBackdropLoaded then
					BackdropTemplateMixin.OnBackdropLoaded(self)
				end
			</OnLoad>
		</Scripts>
	</Frame>

