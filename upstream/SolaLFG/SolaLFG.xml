	<Font name="FP_FontLeft" inherits="FP_FontDefault" justifyH="LEFT" virtual="true"/>

	<!-- Row String Template -->
	<SimpleHTML name="FP_StringTemplate" virtual="true">
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentText" inherits="FP_FontLeft" maxlines="1">
					<Anchors>
						<Anchor point="RIGHT"/>
						<Anchor point="LEFT"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</SimpleHTML>

