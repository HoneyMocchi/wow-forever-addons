			<AbsDimension y="22"/>
		</Size>
		<Frames>
			<Frame name="$parentTime" inherits="FP_StringTemplate">
				<Size>
					<AbsDimension x="44" y="20"/>
				</Size>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT">
