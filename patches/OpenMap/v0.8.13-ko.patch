+local TileReuse = { native = { limit = 96, size = 0, nodes = {} }, lod = { limit = 24, size = 0, nodes = {} }, hits = 0, misses = 0, evictions = 0,
+	budget = math.huge, deferred = false, deferrals = 0 }
+S.tileReuseStats = TileReuse
+local function CacheUnlink(cache, node)
+	if node.prev then node.prev.next = node.next else cache.first = node.next end
+	if node.next then node.next.prev = node.prev else cache.last = node.prev end
+	cache.nodes[node.key] = nil
+	cache.size = cache.size - 1
+	node.prev, node.next = nil, nil
+end
+local function CacheTake(cache, key)
+	local node = cache.nodes[key]
+	if not node then TileReuse.misses = TileReuse.misses + 1; return end
+	CacheUnlink(cache, node)
+	TileReuse.hits = TileReuse.hits + 1
+	return node.value
+end
+local function CachePut(cache, key, value)
+	local node = value.omCacheNode or {}
+	value.omCacheNode = node
+	node.key, node.value, node.prev, node.next = key, value, cache.last, nil
+	if cache.last then cache.last.next = node else cache.first = node end
+	cache.last, cache.nodes[key], cache.size = node, node, cache.size + 1
+	if cache.size > cache.limit then
+		local oldest = cache.first
+		CacheUnlink(cache, oldest)
+		TileReuse.evictions = TileReuse.evictions + 1
+		return oldest.value
+	end
+end
